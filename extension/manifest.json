{
  "manifest_version": 3,
  "name": "NaN for Picked",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:5198/*", "https://pickedhq.pages.dev/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "NaN" },
  "commands": {
    "ask-nan": { "suggested_key": { "default": "Alt+Shift+N" }, "description": "Ask NaN about this page" }
  }
}
